<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Clinic.ViewModels" xmlns:w="using:Clinic.Workspace" xmlns:data="using:Clinic.Data" xmlns:v="using:Clinic.Views" x:Class="Clinic.Views.DashboardView" x:DataType="vm:WorkspaceViewModel">
  <Grid Background="{DynamicResource PageBackground}">
    <Grid ColumnDefinitions="224,*" IsEnabled="{Binding CanInteract}">
      <v:WorkspaceNavigationView/>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="32,26,32,28">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,26">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedText}" FontSize="13"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Content="Обновить" Classes="quiet" Command="{Binding RefreshCommand}" ToolTip.Tip="Загрузить актуальные данные"/>
            <Button Content="{Binding AddLabel}" IsVisible="{Binding CanAdd}" Classes="primary" Command="{Binding AddCommand}"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="10">
          <TextBlock Text="{Binding Owner.ThemeError}" Foreground="{DynamicResource ErrorText}" IsVisible="{Binding Owner.HasThemeError}" TextWrapping="Wrap"/>
          <Border IsVisible="{Binding HasMessage}" Classes="notice" Classes.error="{Binding IsError}" Classes.success="{Binding !IsError}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Закрыть" Classes="quiet" Command="{Binding DismissMessageCommand}"/>
            </Grid>
          </Border>
          <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" Margin="0,0,0,8"/>
        </StackPanel>
        <v:WorkspaceHomeView Grid.Row="2" IsVisible="{Binding IsHome}"/>
        <v:WorkspaceRecordsView Grid.Row="2" IsVisible="{Binding IsTable}"/>
        <Border Grid.Row="2" Classes="card" Padding="32" IsVisible="{Binding IsBackup}" VerticalAlignment="Top">
          <StackPanel Spacing="20">
            <TextBlock Text="Данные под защитой" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding BackupDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" MaxWidth="620" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Создать копию" Classes="primary" Command="{Binding FileCommand}" CommandParameter="backup"/>
              <Button Content="Восстановить из файла" Classes="quiet" Command="{Binding FileCommand}" CommandParameter="restore"/>
            </StackPanel>
            <TextBlock Text="{Binding RestoreDescription}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedText}" MaxWidth="620" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <v:WorkspaceDialogsView/>
  </Grid>
</UserControl>
