<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Clinic.ViewModels"
             xmlns:views="using:Clinic.Views"
             x:Class="Clinic.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBackground}">
  <UserControl.Styles>
    <Style Selector="TextBox.loginInput">
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBox.loginInput:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
    </Style>
    <Style Selector="TextBox.loginInput:focus">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
    </Style>
    <Style Selector="Button.signIn">
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.signIn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="Button.signIn:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonPressedBackground}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
  <Grid ColumnDefinitions="*,*" MinWidth="780" IsVisible="{Binding IsSignedOut}">
    <Border Grid.Column="0" Background="{DynamicResource BrandBackground}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="56,44,56,40">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Grid Width="36" Height="36">
            <Border Background="#FFFFFF" CornerRadius="8" Opacity="0.16"/>
            <TextBlock Text="✚" FontSize="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Медицинская" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="информационная система" Foreground="{DynamicResource BrandMuted}" FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="480" Spacing="22">
          <Border Width="64" Height="64" Background="{DynamicResource BrandLogoBackground}" CornerRadius="16" HorizontalAlignment="Left" Opacity="0.96">
            <TextBlock Text="✚" Foreground="{DynamicResource BrandLogoText}" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Забота о пациентах начинается здесь" TextWrapping="Wrap" FontSize="38" FontWeight="Bold" Foreground="White" LineHeight="46"/>
          <TextBlock Text="Расписание, медицинские карты, приёмы и исследования — в единой системе поликлиники." TextWrapping="Wrap" FontSize="17" Foreground="{DynamicResource BrandMuted}" LineHeight="26"/>
          <Border Background="{DynamicResource BrandInset}" CornerRadius="10" Padding="18,14" Margin="0,16,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="Единое рабочее пространство" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Для пациентов, регистраторов, врачей и администраторов" Foreground="{DynamicResource BrandMuted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Медицинская информационная система " Foreground="{DynamicResource BrandMuted}" FontSize="12"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32" Spacing="20" VerticalAlignment="Center">
      <Button Classes="themeToggle" Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Right"/>
      <TextBlock Text="{Binding ThemeError}" IsVisible="{Binding HasThemeError}" Foreground="{DynamicResource ErrorText}" FontSize="12" TextWrapping="Wrap"/>
      <Border Width="390" MaxWidth="390" HorizontalAlignment="Center" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="36">
        <StackPanel Spacing="0">
          <Border Width="46" Height="46" Background="{DynamicResource InfoBackground}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="✚" Foreground="{DynamicResource InfoText}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Вход в систему" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
          <TextBlock Text="Введите данные своей учётной записи" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,8,0,30"/>
          <TextBlock Text="Логин" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
          <TextBox Classes="loginInput" PlaceholderText="Ваш логин" Text="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Пароль" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,22,0,8"/>
          <TextBox Classes="loginInput" PlaceholderText="Введите пароль" PasswordChar="●" Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" FontSize="12" Margin="0,16,0,0"/>
          <Button Classes="signIn" Command="{Binding SignInCommand}" HorizontalAlignment="Stretch" Margin="0,28,0,0">
            <Button.Template>
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                  <TextBlock Text="Войти" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock Text="{Binding TestAccountsHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,18,0,0"/>
          <TextBlock Text="{Binding DemoCredentials}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,20"/>
          <TextBlock Text="Доступ к разделам определяется вашей ролью. Если у вас нет учётной записи, обратитесь к администратору системы." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" LineHeight="18"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Персональные и медицинские данные доступны только авторизованным пользователям" MaxWidth="390" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource FaintText}" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <views:DashboardView IsVisible="{Binding IsSignedIn}"/>
  </Grid>
</UserControl>
