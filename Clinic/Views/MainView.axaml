<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Clinic.ViewModels"
             xmlns:views="using:Clinic.Views"
             x:Class="Clinic.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBackground}">
  <UserControl.Styles>
    <Style Selector="TextBox.loginInput">
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBox.loginInput:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
    </Style>
    <Style Selector="TextBox.loginInput:focus">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
    </Style>
    <Style Selector="Button.signIn:disabled"><Setter Property="Opacity" Value="0.55"/></Style>
    <Style Selector="Button.signIn">
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.signIn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="Button.signIn:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonPressedBackground}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
  <Grid ColumnDefinitions="*,*" MinWidth="780" IsVisible="{Binding IsSignedOut}">
    <Grid.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SignInCommand}"/></Grid.KeyBindings>
    <Border Grid.Column="0" Background="{DynamicResource BrandBackground}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="56,44,56,40">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Grid Width="36" Height="36">
            <Border Background="#FFFFFF" CornerRadius="8" Opacity="0.16"/>
            <Path Data="M9,1 H17 V9 H25 V17 H17 V25 H9 V17 H1 V9 H9 Z" Width="27" Height="27" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Медицинская" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="информационная система" Foreground="{DynamicResource BrandMuted}" FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="480" Spacing="22">
          <Border Width="64" Height="64" Background="{DynamicResource BrandLogoBackground}" CornerRadius="16" HorizontalAlignment="Left" Opacity="0.96">
            <Path Data="M9,1 H17 V9 H25 V17 H17 V25 H9 V17 H1 V9 H9 Z" Width="38" Height="38" Stretch="Uniform" Fill="{DynamicResource BrandLogoText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Забота о пациентах начинается здесь" TextWrapping="Wrap" FontSize="38" FontWeight="Bold" Foreground="White" LineHeight="46"/>
          <TextBlock Text="Расписание, медицинские карты, приёмы и исследования — в единой системе поликлиники." TextWrapping="Wrap" FontSize="17" Foreground="{DynamicResource BrandMuted}" LineHeight="26"/>
          <Border Background="{DynamicResource BrandInset}" CornerRadius="10" Padding="18,14" Margin="0,16,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="Единое рабочее пространство" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Для пациентов, регистраторов, врачей и администраторов" Foreground="{DynamicResource BrandMuted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Медицинская информационная система " Foreground="{DynamicResource BrandMuted}" FontSize="12"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24" Spacing="16" VerticalAlignment="Center">
      <Button Classes="themeToggle" Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}" IsEnabled="{Binding !IsThemeBusy}" HorizontalAlignment="Right"/>
      <TextBlock Text="{Binding ThemeError}" IsVisible="{Binding HasThemeError}" Foreground="{DynamicResource ErrorText}" FontSize="12" TextWrapping="Wrap"/>
      <Border Width="390" MaxWidth="390" HorizontalAlignment="Center" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="28">
        <StackPanel Spacing="0">
          <TextBlock Text="Вход в систему" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
          <TextBlock Text="Введите данные своей учётной записи" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,8,0,24"/>
          <TextBlock Text="Логин" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
          <TextBox x:Name="LoginInput" IsEnabled="{Binding CanInteract}" Classes="loginInput" MaxLength="50" PlaceholderText="Ваш логин" Text="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Пароль" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,18,0,8"/>
          <TextBox IsEnabled="{Binding CanInteract}" Classes="loginInput" MaxLength="100" PlaceholderText="Введите пароль" PasswordChar="●" RevealPassword="{Binding RevealPassword}" Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Content="Показать пароль" IsChecked="{Binding RevealPassword}" IsEnabled="{Binding CanInteract}" FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,10,0,0"/>
          <StackPanel IsVisible="{Binding HasCaptcha}" Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="Введите символы с картинки" FontSize="12"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <views:CaptchaImage ImageBase64="{Binding CaptchaImageBase64}" Height="68" Stretch="Uniform" HorizontalAlignment="Left"/>
              <Button Grid.Column="1" Content="Обновить" Classes="quiet" Command="{Binding RefreshCaptchaCommand}" IsEnabled="{Binding CanInteract}" ToolTip.Tip="Получить другую картинку"/>
            </Grid>
            <TextBox Text="{Binding CaptchaAnswer, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Символы без учёта регистра" MaxLength="5" IsEnabled="{Binding CanInteract}" ToolTip.Tip="Введите пять букв и цифр с картинки"/>
          </StackPanel>
          <Border Classes="notice" Classes.error="{Binding !IsStatusSuccess}" Classes.success="{Binding IsStatusSuccess}" IsVisible="{Binding HasStatusMessage}" Padding="12" CornerRadius="8" Margin="0,14,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"/></Border>
          <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" Margin="0,12,0,0"/>
          <Button Classes="signIn" IsEnabled="{Binding CanInteract}" Command="{Binding SignInCommand}" HorizontalAlignment="Stretch" Margin="0,20,0,0">
            <Button.Template>
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                  <TextBlock Text="{Binding SignInLabel}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Content="Регистрация пациента" IsEnabled="{Binding CanInteract}" Classes="quiet" Command="{Binding OpenRegistrationCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,16"/>
          <TextBlock Text="Учётные записи сотрудников создаёт администратор поликлиники." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" LineHeight="18"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Персональные и медицинские данные доступны только авторизованным пользователям" MaxWidth="390" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource FaintText}" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <Border IsVisible="{Binding IsSignedIn}"><views:DashboardView DataContext="{Binding Workspace}"/></Border>
  <Border Background="#99000000" IsVisible="{Binding IsRegistrationOpen}">
    <Border Classes="card" Width="480" MaxHeight="650" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="8" Margin="0,0,0,20"><TextBlock Text="Регистрация пациента" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding RegistrationHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12"/></StackPanel>
        <ScrollViewer Grid.Row="1" IsEnabled="{Binding CanInteract}"><StackPanel Spacing="12"><ItemsControl ItemsSource="{Binding RegistrationFields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EditorField"><StackPanel Spacing="6" Margin="0,0,0,14"><TextBlock ToolTip.Tip="{Binding Hint}" Text="{Binding Label}" FontSize="12"/><TextBox IsVisible="{Binding IsText}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PasswordChar="{Binding PasswordChar}" PlaceholderText="{Binding Placeholder}" ToolTip.Tip="{Binding Hint}"/><CalendarDatePicker IsVisible="{Binding IsDate}" SelectedDate="{Binding Date}" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" PlaceholderText="Выберите дату" FirstDayOfWeek="Monday" HorizontalAlignment="Stretch"/><ComboBox IsVisible="{Binding IsChoice}" PlaceholderText="Выберите…" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding RegistrationError}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" IsEnabled="{Binding CanInteract}" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Отмена" Classes="quiet" Command="{Binding CloseRegistrationCommand}"/><Button Content="Зарегистрироваться" Classes="primary" Command="{Binding RegisterCommand}"/></StackPanel>
      </Grid>
    </Border>
  </Border>
  <Border Background="#99000000" IsVisible="{Binding IsRegistrationDiscardOpen}">
    <Border Classes="card" Width="460" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="18">
        <TextBlock Text="Отменить регистрацию?" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="Введённые данные не будут сохранены." Foreground="{DynamicResource MutedText}"/>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Content="Назад" Classes="quiet" Command="{Binding CancelRegistrationDiscardCommand}"/>
          <Button Content="Отменить регистрацию" Classes="primary" Command="{Binding ConfirmRegistrationDiscardCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
  <Border Background="#99000000" IsVisible="{Binding IsExitConfirmOpen}">
    <Border Classes="card" Width="460" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="18">
        <TextBlock Text="{Binding ExitTitle}" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ExitDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Content="Остаться" Classes="quiet" Command="{Binding CancelExitCommand}"/>
          <Button Content="{Binding ExitLabel}" Classes="primary" Command="{Binding ConfirmExitCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</UserControl>
